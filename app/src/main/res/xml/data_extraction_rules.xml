<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ backup and device-transfer rules.
   The Telegram bot token / chat id live in icai_checker_secrets and are excluded
   from both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="icai_checker_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="icai_checker_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
